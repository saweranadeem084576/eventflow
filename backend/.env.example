NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/event-flow
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the Stripe Dashboard
STRIPE_WEBHOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Where uploaded profile pictures are written (defaults to backend/uploads)
UPLOADS_DIR=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EventFlow <no-reply@example.com>
PASSWORD_RESET_URL=http://localhost:5173/reset-password
